<?xml version="1.0" encoding="utf-8"?>
<!-- Полоска прогресса в шапке «Сегодня»: рамка и зелёная заливка внутри. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <solid android:color="@color/w_card" />
            <stroke android:width="1.5dp" android:color="@color/w_ink" />
            <corners android:radius="5dp" />
        </shape>
    </item>
    <item android:id="@android:id/progress" android:left="2.5dp" android:top="2.5dp" android:right="2.5dp" android:bottom="2.5dp">
        <clip>
            <shape android:shape="rectangle">
                <solid android:color="@color/w_green" />
                <corners android:radius="3dp" />
            </shape>
        </clip>
    </item>
</layer-list>
