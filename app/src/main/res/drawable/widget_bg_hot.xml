<?xml version="1.0" encoding="utf-8"?>
<!-- Горящая задача: красная рамка и тень. Жёсткая тень без размытия: нижний слой сдвинут на 2dp. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:left="2dp" android:top="2dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/w_red" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item android:right="2dp" android:bottom="2dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/w_card" />
            <stroke android:width="2dp" android:color="@color/w_red" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</layer-list>
