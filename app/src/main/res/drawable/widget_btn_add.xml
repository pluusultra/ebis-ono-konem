<?xml version="1.0" encoding="utf-8"?>
<!-- Красный «+» в шапке. Жёсткая тень без размытия: нижний слой сдвинут на 0dp. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:left="0dp" android:top="0dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/w_onhay" />
            <corners android:radius="7dp" />
        </shape>
    </item>
    <item android:right="0dp" android:bottom="0dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/w_red" />
            <stroke android:width="2dp" android:color="@color/w_onhay" />
            <corners android:radius="7dp" />
        </shape>
    </item>
</layer-list>
