<?xml version="1.0" encoding="utf-8"?>
<!-- Строка задачи: нажатие в любом месте строки — галочка. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/row"
    android:layout_width="match_parent"
    android:layout_height="30dp"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <ImageView
        android:id="@+id/check"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:contentDescription="Сделал"
        android:src="@drawable/widget_check_off" />

    <TextView
        android:id="@+id/title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/w_ink"
        android:textSize="12.5sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tag_red"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:background="@drawable/widget_tag_red"
        android:fontFamily="monospace"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:textColor="@color/w_white"
        android:textSize="9.5sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tag"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:background="@drawable/widget_tag"
        android:fontFamily="monospace"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:textColor="@color/w_ink"
        android:textSize="9.5sp"
        android:visibility="gone" />
</LinearLayout>
